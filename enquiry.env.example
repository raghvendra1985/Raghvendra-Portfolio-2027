# Copy into Vercel → Settings → Environment Variables for Preview.
# Do not commit real values. Leave both URLs empty and the form opens an email draft instead of storing anything.

# Preferred. Google Apps Script web app URL. Deploy as a web app, execute as you, access: Anyone.
# The script should read JSON and append a row. See the pull request for a starter doPost.
GOOGLE_SHEET_WEBHOOK_URL=

# Alternative: https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=

# Address the sheet script can email. This is not an SMTP password.
ENQUIRY_TO=hello@raghvendrasingh.com

# Analytics needs no variable. Vercel project → Analytics → Enable Web Analytics.
# The site loads /_vercel/insights/script.js. Until the toggle is on, that request 404s and nothing is collected.
# Do not add GA4.
