# Commerce mode: whatsapp | test | live
# Keep whatsapp until Design Roulette AND Design IQ complete:
# payment → webhook → order → customer → entitlement → email → login → /tools
# Never commit live keys. Set them in Vercel Production env, then redeploy.
NEXT_PUBLIC_COMMERCE_MODE=whatsapp
NEXT_PUBLIC_SITE_URL=https://raghvendrasingh.com

# Razorpay — live account, Orders API. Webhook URL: {SITE}/api/webhooks/razorpay
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase — production project. Run supabase/migrations/20260817000000_commerce.sql
# Auth redirect URL: {SITE}/account/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — commerce purchase mail and opted-in buyer Contacts sync only.
# Contact inquiries do not use Resend.
RESEND_API_KEY=

# Contact — Google Workspace SMTP AUTH. Do not move Wix DNS or root MX.
# AUTH as hello@growingwithkid.com (Workspace user). From must be exactly
# portfolio@raghvendrasingh.com (alias / Send mail as). Visitor email is
# Reply-To only — never From. SMTP_PASS is a Google app password; whitespace
# is stripped at runtime. Do not use Gmail or the visitor address as From.
EMAIL_FROM=Raghvendra Singh Portfolio <portfolio@raghvendrasingh.com>
EMAIL_TO=hello@raghvendrasingh.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello@growingwithkid.com
SMTP_PASS=

# Contact rate limiting uses public.contact_rate_events (see supabase/migrations).
# Apply 20260826000000_contact_rate_events.sql before production form traffic.

# Comma-separated admin logins for /admin
ADMIN_EMAILS=hello@raghvendrasingh.com

# Spotify Now Playing (optional). Without these, the floating Music card
# shows a curated rotation. Create an app at https://developer.spotify.com/
# Scope: user-read-currently-playing. Refresh token via Authorization Code.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
