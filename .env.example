# Commerce mode: whatsapp | test | live
# Keep whatsapp until Razorpay + Supabase credentials are verified.
NEXT_PUBLIC_COMMERCE_MODE=whatsapp
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (test keys first). Never expose RAZORPAY_KEY_SECRET to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional mail uses RESEND_API_KEY.
# Promotional Contacts/Segments are synced only for opted-in buyers.
RESEND_API_KEY=
EMAIL_FROM=Raghvendra Singh <hello@raghvendrasingh.com>

# Comma-separated admin logins for /admin
ADMIN_EMAILS=hello@raghvendrasingh.com
